PORT=3000
CORS_ORIGIN=*
MIN_AGE=18

# PostgreSQL
# DIQQAT: baza nomi katta harf bilan yaratilgan bo'lsa (Solvi_base),
# nom katta-kichik harfga sezgir bo'ladi — aynan shunday yozing.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Solvi_base
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Google Sign-In — vergul bilan: Web(serverClientId), Android, iOS client ID lari
GOOGLE_CLIENT_IDS=xxx-web.apps.googleusercontent.com,yyy-ios.apps.googleusercontent.com

# Facebook Login
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Resend (email tasdiqlash kodi uchun) — resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Solvi <onboarding@resend.dev>
OTP_EXPIRES_MINUTES=10
